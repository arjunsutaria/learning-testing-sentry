# Copy this file to .env.local and fill in your values.
# .env.local is gitignored.

# Sentry DSN — used by both the React frontend (via Vite) and the Express
# backend (via dotenv in server/instrument.js). The "VITE_" prefix is required
# for Vite to expose it to the browser bundle.
VITE_SENTRY_DSN=

# Optional: override the Express server port (default: 3001)
# PORT=3001
